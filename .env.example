# --- Pinecone ---
# Get key at: https://app.pinecone.io/ → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=multimodal-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Gemini (Google AI Studio) ---
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
# 1536 = MRL-truncated, good quality/storage balance. Locks the Pinecone index.
EMBEDDING_DIM=1536

# --- OpenRouter (for the LLM that answers your questions) ---
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Swap to any OpenRouter model id: openai/gpt-5, google/gemini-2.5-pro, etc.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- App settings ---
DATA_DIR=./data
CACHE_DIR=./cache
CHUNK_TEXT_TOKENS=1000
CHUNK_TEXT_OVERLAP=200
VIDEO_CLIP_SECONDS=110
LLM_TOP_K=5
LLM_TEMPERATURE=0.2
