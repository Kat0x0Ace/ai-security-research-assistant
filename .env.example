# v2 local stack — copy to .env and adjust if needed.
# Nothing here is secret: the whole stack runs locally with no API keys.

# Embeddings (all-MiniLM-L6-v2 via ONNX Runtime; the only supported model, 384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ChromaDB (local persistent store under cache/chroma)
CHROMA_COLLECTION=rag_agent

# Ollama (OpenAI-compatible endpoint; requires `ollama serve` + a pulled model)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Retrieval guardrail: chunks farther than this cosine distance are treated
# as "not relevant" and trigger the refusal path. Measured on the sample
# corpus: real questions score 0.25-0.69, off-topic messages 0.84-0.96.
RETRIEVAL_MAX_DISTANCE=0.75

# Hybrid retrieval (vectors + BM25 keyword search, fused with RRF). 0 = vector-only.
HYBRID_SEARCH=1

# Per-claim citation check: after each answer, one extra LLM call verifies every
# cited sentence against the passage it cites and flags unsupported claims. 0 = off.
CITATION_CHECK=1

# App paths + chunking
DATA_DIR=./data
CACHE_DIR=./cache
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=40
LLM_TOP_K=3
LLM_TEMPERATURE=0.2
